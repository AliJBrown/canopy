# Copy this file to .env and fill in the values before deploying.

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_DB=ticketing
POSTGRES_USER=ticketing
POSTGRES_PASSWORD=change-me

# ── MinIO (object storage) ───────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=canopy-attachments
# Public URL used by clients to fetch attachments (e.g. https://storage.example.com)
MINIO_PUBLIC_URL=http://localhost:9000

# ── Backend ───────────────────────────────────────────────────────────────────
NODE_ENV=production
# Must be a strong random secret in production
JWT_SECRET=change-me

BACKEND_URL=https://api.example.com
FRONTEND_URL=https://example.com

# ── Google OAuth (optional — leave blank to disable) ────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── SMTP / email (optional — leave blank to disable) ────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Canopy <noreply@example.com>
APP_URL=https://example.com

# ── Backups ───────────────────────────────────────────────────────────────────
# Cron schedule for nightly backups (default: 2am daily)
BACKUP_SCHEDULE=0 2 * * *
# Days to retain database dump files
BACKUP_RETENTION_DAYS=30
# Set to true to run a backup immediately when the container starts
BACKUP_ON_START=false
# Optional: rclone destination for off-site sync (leave blank to disable)
# Examples:
#   BACKUP_RCLONE_DEST=s3:my-bucket/canopy-backups
#   BACKUP_RCLONE_DEST=b2:my-bucket/canopy-backups
#   BACKUP_RCLONE_DEST=sftp:myserver.com/backups/canopy
# Place rclone credentials in ./config/rclone.conf, or use RCLONE_CONFIG_* env vars.
# See https://rclone.org/docs/ for supported providers and config format.
BACKUP_RCLONE_DEST=

# ── Frontend ──────────────────────────────────────────────────────────────────
# Port the app is served on. Use 8080 for production, 3000 for local dev.
FRONTEND_PORT=8080
# Leave blank — nginx proxies /api/ to the backend container internally.
# Only set this if you are NOT using the nginx proxy (e.g. running frontend standalone).
VITE_API_URL=
