# Copy this file to .env and fill in the values before deploying.

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_DB=ticketing
POSTGRES_USER=ticketing
POSTGRES_PASSWORD=change-me

# ── MinIO (object storage) ───────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=canopy-attachments
# Public URL used by clients to fetch attachments (e.g. https://storage.example.com)
MINIO_PUBLIC_URL=http://localhost:9000

# ── Backend ───────────────────────────────────────────────────────────────────
NODE_ENV=production
# Must be a strong random secret in production
JWT_SECRET=change-me

BACKEND_URL=https://api.example.com
FRONTEND_URL=https://example.com

# ── Google OAuth (optional — leave blank to disable) ────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── SMTP / email (optional — leave blank to disable) ────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Canopy <noreply@example.com>
APP_URL=https://example.com

# ── Frontend (build-time) ────────────────────────────────────────────────────
VITE_API_URL=https://api.example.com
